@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@model Nadasdladany.Models.Representative
@{
    ViewData["Title"] = Model?.Name ?? "Polgármester";
    var greetingTitle = "Polgármesteri Köszöntő";
    var roleDisplay = Model?.CustomTitleOverride ?? "Polgármester";
}

<div class="container content-padding">
    <div class="page-header mb-4 text-center">
        <h1>@greetingTitle</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="row">
        <div class="col-lg-10 offset-lg-1">
            @if (Model != null)
            {
                <!-- FIX 1: Add position-relative here to make the whole card the anchor -->
                <div class="card shadow-sm mb-4 position-relative">

                    <!-- FIX 2: Move the button here and add an inline style for positioning -->
                    @if (User.IsInRole("Administrator"))
                    {
                        <button class="btn btn-warning btn-sm card-edit-btn"
                                style="bottom: 1rem; right: 1rem;"
                                data-bs-toggle="modal"
                                data-bs-target="#editMayorModal"
                                data-rep-id="@Model.Id"
                                data-rep-name="@Model.Name"
                                data-rep-customtitle="@Model.CustomTitleOverride"
                                data-rep-email="@Model.Email"
                                data-rep-phone="@Model.PhoneNumber"
                                data-rep-reception="@Model.ReceptionHoursInfo"
                                data-rep-imageurl="@Model.ImageUrl"
                                data-rep-bio="@Model.Biography">
                            <i class="bi bi-pencil-fill"></i> Adatlap szerkesztése
                        </button>
                    }

                    <div class="row g-0">
                        <div class="col-md-4 text-center p-3 d-flex flex-column align-items-center justify-content-center" style="background-color: var(--bs-light-bg-subtle);">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Url.Content(Model.ImageUrl)" class="img-fluid rounded-circle shadow-sm mb-3" alt="@Model.Name" style="max-width: 200px; height:200px; object-fit:cover; border: 5px solid var(--bs-primary);">
                            }
                            else
                            {
                                <img src="~/img/placeholder-avatar.png" class="img-fluid rounded-circle shadow-sm mb-3" alt="Avatar" style="max-width: 200px; height:200px; object-fit:cover; border: 5px solid var(--bs-gray-400);">
                            }
                            <h4 class="mb-1">@Model.Name</h4>
                            <p class="text-muted">@roleDisplay</p>
                            <hr class="w-75">
                            <div class="small text-start">
                                @if (!string.IsNullOrEmpty(Model.ReceptionHoursInfo))
                                {
                                    <p class="mb-1"><strong><i class="bi bi-calendar-week me-1"></i>Fogadóóra:</strong> @Model.ReceptionHoursInfo</p>
                                }
                                @if (!string.IsNullOrEmpty(Model.Email))
                                {
                                    <p class="mb-1"><strong><i class="bi bi-envelope-fill me-1"></i>E-mail:</strong> <a href="mailto:@Model.Email">@Model.Email</a></p>
                                }
                                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                {
                                    <p class="mb-0"><strong><i class="bi bi-telephone-fill me-1"></i>Telefon:</strong> @Model.PhoneNumber</p>
                                }
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h3 class="card-title text-primary mb-3">Tisztelt Nádasdladányiak és Kedves Látogatók!</h3>
                                @if (!string.IsNullOrEmpty(Model.Biography))
                                {
                                    @Html.Raw(Model.Biography)
                                }
                                else
                                {
                                    <p><em>A polgármester bemutatkozása feltöltés alatt.</em></p>
                                    <p>Engedjék meg, hogy Nádasdladány község polgármestereként tisztelettel és szeretettel köszöntsem Önöket településünk hivatalos honlapján.</p>
                                    <p>Célunk, hogy ezen a felületen keresztül átfogó képet adjunk településünk mindennapjairól, működéséről, valamint lehetőséget biztosítsunk az egyszerű és gyors tájékozódásra.</p>
                                    <p>Bízom benne, hogy a honlap hasznos és informatív lesz mindenki számára.</p>
                                    <p class="mt-4"><em>Üdvözlettel,<br />@Model.Name<br />@roleDisplay</em></p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">A polgármester adatai jelenleg nem elérhetőek.</div>
            }
        </div>
    </div>
</div>

@if (SignInManager.IsSignedIn(User) && User.IsInRole("Administrator") && Model != null)
{
    <!-- MODAL for Editing Mayor Details (No changes needed here) -->
    <div class="modal fade" id="editMayorModal" tabindex="-1" aria-labelledby="editMayorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-controller="Municipality" asp-action="EditMayor" method="post" enctype="multipart/form-data">
                    <div class="modal-header"><h5 class="modal-title" id="editMayorModalLabel">Polgármester adatainak szerkesztése</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="editRepId" name="Id" />
                        <input type="hidden" name="Role" value="@(Nadasdladany.Models.RepresentativeRole.Polgarmester)" />
                        <input type="hidden" name="DisplayOrder" value="@Model.DisplayOrder" />
                        <div class="mb-3"><label for="editRepName" class="form-label fw-bold">Név</label><input type="text" id="editRepName" name="Name" class="form-control" required></div>
                        <div class="mb-3"><label for="editRepCustomTitle" class="form-label">Egyéni titulus</label><input type="text" id="editRepCustomTitle" name="CustomTitleOverride" class="form-control" placeholder="Pl. Polgármester, Országgyűlési képviselő"></div>
                        <div class="row">
                            <div class="col-md-6 mb-3"><label for="editRepEmail" class="form-label">E-mail</label><input type="email" id="editRepEmail" name="Email" class="form-control"></div>
                            <div class="col-md-6 mb-3"><label for="editRepPhone" class="form-label">Telefonszám</label><input type="tel" id="editRepPhone" name="PhoneNumber" class="form-control"></div>
                        </div>
                        <hr />
                        <div class="mb-3">
                            <label for="ImageFile" class="form-label">Új fotó feltöltése (lecseréli a régit)</label>
                            <input type="file" name="ImageFile" class="form-control" accept="image/jpeg, image/png, image/webp">
                        </div>
                        <div id="mayorImagePreviewContainer" class="mt-3 border-top pt-3" style="display:none;">
                            <label class="form-label">Jelenlegi fotó:</label>
                            <div><img id="mayorImagePreview" src="" alt="Jelenlegi fotó" style="max-height: 150px; border-radius: 5px;" /></div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" name="RemoveCurrentImage" value="true" id="mayorRemoveImageCheckbox">
                                <label class="form-check-label" for="mayorRemoveImageCheckbox">
                                    Jelenlegi fotó törlése
                                </label>
                            </div>
                        </div>
                        <hr />
                        <div class="mb-3"><label for="editRepReception" class="form-label">Fogadóóra</label><input type="text" id="editRepReception" name="ReceptionHoursInfo" class="form-control" placeholder="Minden hónap első keddjén..."></div>
                        <div class="mb-3"><label for="editRepBio" class="form-label">Bemutatkozás / Köszöntő</label><textarea id="editRepBio" name="Biography" class="form-control" rows="10"></textarea></div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Mégse</button><button type="submit" class="btn btn-primary">Módosítások mentése</button></div>
                </form>
            </div>
        </div>
    </div>
}


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var mayorModal = document.getElementById('editMayorModal');
            if (mayorModal) {
                mayorModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    // --- Get data from button ---
                    var id = button.getAttribute('data-rep-id');
                    var name = button.getAttribute('data-rep-name');
                    var customTitle = button.getAttribute('data-rep-customtitle');
                    var email = button.getAttribute('data-rep-email');
                    var phone = button.getAttribute('data-rep-phone');
                    var reception = button.getAttribute('data-rep-reception');
                    var imageUrl = button.getAttribute('data-rep-imageurl');
                    var bio = button.getAttribute('data-rep-bio');

                    // --- Populate standard text fields ---
                    mayorModal.querySelector('#editRepId').value = id;
                    mayorModal.querySelector('#editRepName').value = name;
                    mayorModal.querySelector('#editRepCustomTitle').value = customTitle;
                    mayorModal.querySelector('#editRepEmail').value = email;
                    mayorModal.querySelector('#editRepPhone').value = phone;
                    mayorModal.querySelector('#editRepReception').value = reception;
                    mayorModal.querySelector('#editRepBio').value = bio;

                    // --- Handle image preview logic ---
                    var previewContainer = mayorModal.querySelector('#mayorImagePreviewContainer');
                    var previewImage = mayorModal.querySelector('#mayorImagePreview');
                    var removeCheckbox = mayorModal.querySelector('#mayorRemoveImageCheckbox');

                    // Reset state
                    removeCheckbox.checked = false;

                    if (imageUrl && imageUrl.trim() !== '') {
                        previewContainer.style.display = 'block';
                        previewImage.src = imageUrl;
                    } else {
                        previewContainer.style.display = 'none';
                        previewImage.src = '';
                    }
                });
            }
        });
    </script>
}