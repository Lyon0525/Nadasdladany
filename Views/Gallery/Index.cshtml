@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@model IEnumerable<Nadasdladany.Models.GalleryImage>
@{
    ViewData["Title"] = ViewData["Title"] as string ?? "Galéria";
    var albums = ViewBag.Albums as List<Nadasdladany.Models.GalleryAlbum> ?? new List<Nadasdladany.Models.GalleryAlbum>();
    var currentAlbumSlug = ViewBag.CurrentAlbumSlug as string;
    var currentAlbum = ViewBag.CurrentAlbum as Nadasdladany.Models.GalleryAlbum;
}

<div class="container content-padding">
    <div class="page-header mb-4 text-center">
        <h1>@ViewData["Title"]</h1>
        @if (currentAlbum != null && !string.IsNullOrEmpty(currentAlbum.Description))
        {
            <p class="lead text-muted-color">@currentAlbum.Description</p>
        }
        else
        {

            <p class="lead text-muted-color">Válogatás községünk életének legszebb pillanataiból, eseményeiből és látnivalóiból.</p>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <!-- NEW: Admin Control Bar -->
    @if (User.IsInRole("Administrator"))
    {
        <div class="admin-controls-bar d-flex justify-content-center gap-3 p-3 mb-4 bg-light-subtle border rounded shadow-sm">
            <a asp-controller="Gallery" asp-action="ManageAlbums" class="btn btn-secondary"><i class="bi bi-images me-2"></i>Albumok Kezelése</a>
            <button class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#addImageModal"><i class="bi bi-plus-circle-fill me-2"></i>Új kép feltöltése</button>
        </div>
    }

    @if (albums.Any())
    {
        <div class="gallery-filters text-center mb-4 pb-3 border-bottom">@* ... Filter buttons ... *@</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-3 gallery-grid">
            @foreach (var image in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3 d-flex align-items-stretch">
                    <!-- Added card-admin-container -->
                    <div class="card gallery-item-card shadow-sm w-100 card-admin-container">
                        @if (User.IsInRole("Administrator"))
                        {
                            <div class="card-admin-controls">
                                <button type="button" class="admin-card-btn btn-edit" title="Kép adatainak szerkesztése"
                                        data-bs-toggle="modal" data-bs-target="#editImageModal"
                                        data-image-id="@image.Id"
                                        data-image-title="@image.Title"
                                        data-image-alt="@image.AltText"
                                        data-image-description="@image.Description"
                                        data-image-albumid="@image.GalleryAlbumId">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                                <button type="button" class="admin-card-btn btn-delete" title="Kép törlése"
                                        data-bs-toggle="modal" data-bs-target="#deleteImageModal"
                                        data-image-id="@image.Id"
                                        data-image-title="@image.Title">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </div>
                        }

                        <a href="#" data-bs-toggle="modal" data-bs-target="#imagePreviewModal" @* Changed ID *@
                           data-image-url="@Url.Content(image.ImageUrl)"
                           data-image-title="@(image.Title ?? image.GalleryAlbum?.Title)">
                            <img src="@Url.Content(image.ThumbnailUrl ?? image.ImageUrl)" class="gallery-thumbnail" alt="@(image.AltText ?? image.Title)">
                        </a>
                        @if (!string.IsNullOrEmpty(image.Title))
                        {
                            <div class="card-body text-center py-2 px-2"><small class="card-text text-muted">@image.Title</small></div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4 text-center shadow-sm">
            <i class="bi bi-info-circle-fill me-2"></i>Nincsenek megjeleníthető képek ebben az albumban vagy kategóriában.
        </div>
    }
</div>

<!-- Public Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white" id="imagePreviewModalLabel"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-0">
                <img id="modalImage" src="" class="img-fluid" alt="Nagyított kép" style="max-height: 90vh;">
            </div>
            <div id="modalDescriptionContainer" class="text-white text-center py-2" style="background-color: rgba(0,0,0,0.5);">
                <!-- The description will be inserted here by JavaScript -->
            </div>
        </div>
    </div>
</div>

@if (SignInManager.IsSignedIn(User) && User.IsInRole("Administrator"))
{
    <!-- ADMIN MODALS -->
    <!-- "ADD IMAGE" MODAL -->
    <div class="modal fade" id="addImageModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Gallery" asp-action="CreateImage" method="post" enctype="multipart/form-data">
                    <div class="modal-header"><h5 class="modal-title">Új kép feltöltése</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <div class="mb-3"><label class="form-label">Fájl kiválasztása (kötelező)</label><input type="file" name="ImageFile" class="form-control" required accept="image/*"></div>
                        <div class="mb-3"><label class="form-label">Album (kötelező)</label><select name="GalleryAlbumId" class="form-select" required><option value="">Válasszon albumot...</option>@foreach(var album in albums){
                        <option value="@album.Id">@album.Title</option>
                    }
</select></div>
                    <hr />
                    <div class="mb-3"><label class="form-label">Kép címe (opcionális)</label><input type="text" name="Title" class="form-control"></div>
                    <div class="mb-3"><label class="form-label">Leírás (opcionális)</label><textarea name="Description" class="form-control" rows="3"></textarea></div>
                    <div class="mb-3"><label class="form-label">Helyettesítő szöveg (SEO, opcionális)</label><input type="text" name="AltText" class="form-control"></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Mégse</button><button type="submit" class="btn btn-primary">Feltöltés</button></div>
            </form>
        </div>
    </div>
</div>

<!-- "EDIT IMAGE" MODAL -->
<div class="modal fade" id="editImageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Gallery" asp-action="EditImage" method="post">
                <div class="modal-header"><h5 class="modal-title">Kép adatainak szerkesztése</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editImageId" name="Id" />
                    <div class="mb-3"><label class="form-label">Album</label><select id="editImageAlbumId" name="GalleryAlbumId" class="form-select" required>@foreach(var album in albums){
                    <option value="@album.Id">@album.Title</option>
                                        }
</select></div>
                    <hr />
                    <div class="mb-3"><label class="form-label">Kép címe</label><input type="text" id="editImageTitle" name="Title" class="form-control"></div>
                    <div class="mb-3"><label class="form-label">Leírás</label><textarea id="editImageDescription" name="Description" class="form-control" rows="3"></textarea></div>
                    <div class="mb-3"><label class="form-label">Helyettesítő szöveg (SEO)</label><input type="text" id="editImageAltText" name="AltText" class="form-control"></div>
                    <div class="form-text">Megjegyzés: Magát a képet lecserélni itt nem lehet. Ahhoz törölje a régit és töltse fel az újat.</div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Mégse</button><button type="submit" class="btn btn-primary">Módosítások mentése</button></div>
            </form>
        </div>
    </div>
</div>

<!-- "DELETE IMAGE" MODAL -->
<div class="modal fade" id="deleteImageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Gallery" asp-action="DeleteImage" method="post">
                <div class="modal-header"><h5 class="modal-title">Törlés megerősítése</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteImageId" name="Id" />
                    <p>Biztosan törölni szeretné ezt a képet? <br /><strong id="deleteImageTitle"></strong></p>
                    <p class="text-danger fw-bold">A művelet a fájlt is véglegesen törli a szerverről!</p>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Mégse</button><button type="submit" class="btn btn-danger">Igen, törlöm</button></div>
            </form>
        </div>
    </div>
</div>
}

@section Styles {
    <style>
        .gallery-grid .gallery-item-card {
            overflow: hidden;
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            cursor: pointer;
        }

            .gallery-grid .gallery-item-card:hover {
                transform: translateY(-5px) scale(1.03);
                box-shadow: 0 8px 20px rgba(0,0,0,0.15) !important;
            }

        .gallery-thumbnail {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .modal-content {
            border-radius: 0.5rem;
            background-color: var(--dark-bg); /* Dark modal */
            color: var(--text-color-light);
        }

        .modal-header, .modal-footer {
            border-color: rgba(255,255,255,0.2);
        }
        /* Light border for dark modal */
        .btn-close-white {
            filter: invert(1) grayscale(100%) brightness(200%);
        }
        /* Ensure close button is visible on dark */
        #modalImage {
            max-height: 80vh;
            border-radius: 0.25rem 0.25rem 0 0;
        }

        #modalDescriptionContainer {
            background-color: rgba(0,0,0,0.3);
            min-height: 50px;
            padding: 0.5rem 1rem;
        }

        .active-filter {
            font-weight: bold; /* For filter buttons */
        }

        .page-header h1 {
            color: var(--primary-color);
        }

        .admin-controls-bar {
            background-color: var(--bs-tertiary-bg);
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var imageModal = document.getElementById('imageModal');
            var previewModal = document.getElementById('imagePreviewModal');
            var editModal = document.getElementById('editImageModal');
            if (imageModal) {
                imageModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var imageUrl = button.getAttribute('data-image-url');
                    var imageTitle = button.getAttribute('data-image-title');
                    var imageDescription = button.getAttribute('data-image-description');

                    var modalTitle = imageModal.querySelector('.modal-title');
                    var modalImage = imageModal.querySelector('#modalImage');
                    var modalDescriptionContainer = imageModal.querySelector('#modalDescriptionContainer');

                    modalTitle.textContent = imageTitle || 'Képnézegető';
                    modalImage.src = imageUrl;
                    modalImage.alt = imageTitle || 'Nagyított kép';

                    if(imageDescription && imageDescription.trim() !== "") {
                        modalDescriptionContainer.innerHTML = `<p class="mb-0 small">${imageDescription}</p>`;
                        modalDescriptionContainer.style.display = 'block';
                    } else {
                        modalDescriptionContainer.innerHTML = '';
                        modalDescriptionContainer.style.display = 'none'; // Hide if no description
                    }
                });
            }
            if(editModal) {
                editModal.addEventListener('show.bs.modal', function(event) {
                    var button = event.relatedTarget;
                    editModal.querySelector('#editImageId').value = button.getAttribute('data-image-id');
                    editModal.querySelector('#editImageAlbumId').value = button.getAttribute('data-image-albumid');
                    editModal.querySelector('#editImageTitle').value = button.getAttribute('data-image-title');
                    editModal.querySelector('#editImageDescription').value = button.getAttribute('data-image-description');
                    editModal.querySelector('#editImageAltText').value = button.getAttribute('data-image-alt');
                });
            }

            var deleteModal = document.getElementById('deleteImageModal');
            if(deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function(event) {
                    var button = event.relatedTarget;
                    deleteModal.querySelector('#deleteImageId').value = button.getAttribute('data-image-id');
                    deleteModal.querySelector('#deleteImageTitle').textContent = button.getAttribute('data-image-title') || "Névtelen kép";
                });
            }

            if (previewModal) {
                previewModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var imageUrl = button.getAttribute('data-image-url');
                    var imageTitle = button.getAttribute('data-image-title');
                    var imageDescription = button.getAttribute('data-image-description');

                    var modalTitle = previewModal.querySelector('.modal-title');
                    var modalImage = previewModal.querySelector('#modalImage');
                    var modalDescriptionContainer = previewModal.querySelector('#modalDescriptionContainer');

                    modalTitle.textContent = imageTitle || 'Képnézegető';
                    modalImage.src = imageUrl;
                    modalImage.alt = imageTitle || 'Nagyított kép';

                    if (imageDescription && imageDescription.trim() !== "") {
                        modalDescriptionContainer.innerHTML = `<p class="mb-0 small">${imageDescription}</p>`;
                        modalDescriptionContainer.style.display = 'block';
                    } else {
                        modalDescriptionContainer.innerHTML = '';
                        modalDescriptionContainer.style.display = 'none';
                    }
                });
            }
        });
    </script>
}